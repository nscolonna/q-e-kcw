&control
    calculation = 'scf'
    restart_mode = 'from_scratch'
    prefix = 'pb_nc'
    pseudo_dir = '../../pseudo/'
    outdir = './out'
/
&system
    ibrav = 2,
    celldm(1) = 9.27
    nat = 1, ntyp = 1,
    ecutwfc = 40.0,
    nbnd = 26
    noncolin = .true.
    lspinorb = .true.
    occupations = 'smearing'
    smearing = 'mp'
    degauss = 0.025
/
&electrons
    diagonalization = 'david'
    mixing_beta = 0.7
    conv_thr = 1.0d-10
    ! Converge the empty bands too: they enter the disentanglement window
    diago_full_acc = .true.
/
ATOMIC_SPECIES
Pb 207.2 pb_s.UPF
ATOMIC_POSITIONS crystal
Pb 0.00 0.00 0.00
K_POINTS crystal

! pw2wannier90 in library mode with noncollinear (spinor) projections.
!
! fcc Pb with spin-orbit coupling: the 6p splitting is ~1 eV, against ~0.05 eV
! for Si, so the spinor projection factors actually matter here.
!
! The [1,1,1] on the projection line is the spin quantisation axis. Away from z,
! compute_amn takes the general branch that builds the spinor from spin_qaxis
! rather than just picking a component, and that axis has to arrive normalised --
! Wannier90 normalises a projection's z and x axes but not its quantisation axis.
!
! No (u)/(d) on the line, so Wannier90 spin-expands it: 4 sp3 orbitals become
! 8 projections, one per Wannier function.

! Bands 23-26 are degenerate at Gamma: 24 would keep an arbitrary half of the
! multiplet and make the result depend on the MPI layout.
num_bands = 26
num_wann  = 8
spinors   = .true.

dis_win_min  = -3.0
dis_win_max  = 32.0
dis_froz_min = -3.0
dis_froz_max = 13.5

dis_num_iter = 20
num_iter     = 20
num_print_cycles = 20

begin projections
Pb:sp3[1,1,1]
end projections

begin unit_cell_cart
bohr
-4.635  0.000  4.635
 0.000  4.635  4.635
-4.635  4.635  0.000
end unit_cell_cart

begin atoms_frac
Pb 0.00 0.00 0.00
end atoms_frac

mp_grid = 4 4 4

begin kpoints
  0.00000000  0.00000000  0.00000000
  0.00000000  0.00000000  0.25000000
  0.00000000  0.00000000  0.50000000
  0.00000000  0.00000000  0.75000000
  0.00000000  0.25000000  0.00000000
  0.00000000  0.25000000  0.25000000
  0.00000000  0.25000000  0.50000000
  0.00000000  0.25000000  0.75000000
  0.00000000  0.50000000  0.00000000
  0.00000000  0.50000000  0.25000000
  0.00000000  0.50000000  0.50000000
  0.00000000  0.50000000  0.75000000

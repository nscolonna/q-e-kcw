--------
&inputepw
  prefix        = 'lif'
  outdir        = './'

  elph          = .true.
  epwread       = .true.

  lpolar        = .true.
  nbndsub       =  3
  dvscf_dir     = './save/'

  bands_skipped = 'exclude_bands = 1, 5:30'
  wannierize    = .false.

  plrn              = .true.
  restart_plrn      = .false.
  type_plrn         = 1
  init_plrn         = 1
  init_sigma_plrn   = 0.1
  niter_plrn        = 500
  conv_thr_plrn     = 1.0D-4
  full_diagon_plrn  = .true.

  scell_mat_plrn    = .true.
  scell_mat(1, 1:3) = -2,  2, -2
  scell_mat(2, 1:3) = -2,  2,  2
  scell_mat(3, 1:3) =  2,  2, -2

  nk1           = 4
  nk2           = 4
  nk3           = 4
  nq1           = 4
  nq2           = 4
  nq3           = 4
 /

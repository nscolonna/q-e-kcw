--------
&inputepw
  prefix        = 'lif'
  outdir        = './'

  elph          = .true.
  epwread       = .true.

  lpolar        = .true.
  nbndsub       =  3
  dvscf_dir     = './save/'

  bands_skipped = 'exclude_bands = 1, 5:30'
  wannierize    = .false.

  plrn              = .true.
  restart_plrn      = .true.
  type_plrn         = 1

  interp_Ank_plrn   = .true.
  interp_Bqu_plrn   = .true.
  cal_psir_plrn     = .true.
  step_wf_grid_plrn = 4
  filkf             = './GX.txt'
  filqf             = './GX.txt'

  nkf1          = 8
  nkf2          = 8
  nkf3          = 8
  nqf1          = 8
  nqf2          = 8
  nqf3          = 8

  nk1           = 4
  nk2           = 4
  nk3           = 4
  nq1           = 4
  nq2           = 4
  nq3           = 4
 /

  init_plrn         = 6
  init_ntau_plrn    = 1
  niter_plrn        = 1
  full_diagon_plrn  = .true.

  nkf1          = 8
  nkf2          = 8
  nkf3          = 8
  nqf1          = 8
  nqf2          = 8
  nqf3          = 8

  nk1           = 4
  nk2           = 4
  nk3           = 4
  nq1           = 4
  nq2           = 4
  nq3           = 4

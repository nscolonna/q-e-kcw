! pw2wannier90 in library mode with hydrogenic projections of radial index
! r > 1 and zona /= 1. With no minimisation steps, the Wannier90 output is
! that of the initial projection, so it tests the amn computed by pw2wannier90.

num_bands = 12
num_wann  = 8

dis_win_max  = 17.0
dis_froz_max =  6.5

dis_num_iter = 0
num_iter     = 0

begin projections
f=0.00,0.00,0.00 : sp3 : r=2 : zona=1.5
f=0.25,0.25,0.25 : sp3 : r=3 : zona=2.0
end projections

begin unit_cell_cart
bohr
-5.131550922   0.000000000   5.131550922
 0.000000000   5.131550922   5.131550922
-5.131550922   5.131550922   0.000000000
end unit_cell_cart

begin atoms_frac
Si  0.00  0.00  0.00
Si  0.25  0.25  0.25
end atoms_frac

mp_grid = 3 3 3

begin kpoints
  0.00000000  0.00000000  0.00000000
  0.00000000  0.00000000  0.33333333
  0.00000000  0.00000000  0.66666667
  0.00000000  0.33333333  0.00000000
  0.00000000  0.33333333  0.33333333

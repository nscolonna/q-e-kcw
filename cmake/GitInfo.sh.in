#!/bin/sh

# helper script used by GitInfo.cmake

${CMAKE_COMMAND} -E echo_append "#define GIT_BRANCH_RAW \"" > ${GITREV_TMP}
${GIT_EXECUTABLE} rev-parse --abbrev-ref HEAD | sed "s/$/\"/" >> ${GITREV_TMP}
${CMAKE_COMMAND} -E echo >> ${GITREV_TMP}
${CMAKE_COMMAND} -E echo_append "#define GIT_HASH_RAW \"" >> ${GITREV_TMP}
${GIT_EXECUTABLE} describe --always --dirty --abbrev=40 --match="NoTagWithThisName" | sed "s/$/\"/" >> ${GITREV_TMP}
${CMAKE_COMMAND} -E echo >> ${GITREV_TMP}
${CMAKE_COMMAND} -E echo_append "#define GIT_COMMIT_LAST_CHANGED_RAW \"" >> ${GITREV_TMP}
${GIT_EXECUTABLE} log -1 --format=%ad | sed "s/$/\"/" >> ${GITREV_TMP}
${CMAKE_COMMAND} -E echo >> ${GITREV_TMP}
${CMAKE_COMMAND} -E echo_append "#define GIT_COMMIT_SUBJECT_RAW \"" >> ${GITREV_TMP}
${GIT_EXECUTABLE} log -1 --format=%s | cut -c 1-50 | sed ${SED_FLAG} "s/\"/\"\\/\\/'\"'\\/\\/\"/g" | tr -d "\\n" >> ${GITREV_TMP}
${CMAKE_COMMAND} -E echo_append "\"" >> ${GITREV_TMP}
${CMAKE_COMMAND} -E echo >> ${GITREV_TMP}
${CMAKE_COMMAND} -E copy_if_different ${GITREV_TMP} ${GITREV_FILE}
${CMAKE_COMMAND} -E remove ${GITREV_TMP}

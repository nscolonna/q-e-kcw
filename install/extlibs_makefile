# Makefile for fundamental math and utility libraries

include ../make.inc
include install_utils

# MAIN target

all: libdevx libmbd

###################################
# devxlib
###################################

# download and compile devxlib, if file "libdevx" is not present;
# touch file "libdevx" so next time devxlib is not downloaded and compiled 
libdevx :
	$(call update_submodule,external,devxlib)
	cd $(TOPDIR)/external/devxlib/src; \
	ln -fs $(BUILDDIR)/make.inc ../; \
	$(MAKE) all ; \
	if test ! -d $(BUILDDIR)/devxlib/src; then \
	    mkdir -p $(BUILDDIR)/devxlib/src ; \
	    mv *.o *.mod *.a $(BUILDDIR)/devxlib/src/ ; fi
	touch $(BUILDDIR)/install/libdevx

# normal clean (does not remove make.inc)
libdevx_clean:
	if test -f $(TOPDIR)/external/devxlib/make.inc; then \
	   cd $(TOPDIR)/external/devxlib; $(MAKE) clean; fi
	if test -d $(BUILDDIR)/devxlib/src; then \
		rm -r $(BUILDDIR)/devxlib; fi
	if test -f $(BUILDDIR)/install/libdevx; then rm $(BUILDDIR)/install/libdevx; fi
# file "libdevx" removed so next time it is downloaded and compiled again

libdevx_veryclean:
	if test -d $(TOPDIR)/external/devxlib; then \
	   (cd $(TOPDIR)/external/devxlib; if test -f make.inc; then \
	      ($(MAKE) distclean && rm -f make.inc); fi); fi

###################################
# LIBMBD
###################################

libmbd:
	$(call update_submodule,external,mbd)
	if test ! -d $(BUILDDIR)/MBD; then \
        mkdir $(BUILDDIR)/MBD; \
        cd $(TOPDIR)/external/mbd/src; \
        export FXX=$(F90); export FXXOPT="$(F90FLAGS)"; \
        $(MAKE) -f ../../mbd.make ; mv *.o *.mod *.a $(BUILDDIR)/MBD; cd ../../.. ;fi

libmbd_clean:
	if test -d $(BUILDDIR)/MBD; then (rm -R -f $(BUILDDIR)/MBD); fi
	if test -d $(TOPDIR)/external/mbd/src; then cd $(TOPDIR)/external/mbd/src; \
          $(MAKE) -f ../../mbd.make clean; fi

libmbd_distclean:
	if test -d $(BUILDDIR)/MBD; then (rm -R -f $(BUILDDIR)/MBD); fi
	if test -d $(TOPDIR)/external/mbd/src; then cd $(TOPDIR)/external/mbd/src; \
          $(MAKE) -f ../../mbd.make distclean; fi

###########################################################
# wannier90
###########################################################

libw90: w90git w90make

w90git:
	$(call update_submodule,external,wannier90)
	touch $(BUILDDIR)/install/w90git
# file "w90git" is touched so next time w90 is not downloaded

# compile W90 sources, install library, executables, sources,
# respectively in lib/, bin/, obj/ under $(BUILDDIR)/wannier90
w90make: w90git
	cp $(BUILDDIR)/install/make_wannier90.inc \
	   $(TOPDIR)/external/wannier90/make.inc
	cd $(TOPDIR)/external/wannier90; $(MAKE) lib ; \
	$(MAKE) PREFIX=$(BUILDDIR)/wannier90 install ; \
	cd src/obj ; mkdir $(BUILDDIR)/wannier90/obj ; \
	cp *.o *.mod $(BUILDDIR)/wannier90/obj
	touch $(BUILDDIR)/install/w90make
# file "w90make" is touched so next time w90 is not compiled

w90_clean:
	rm -f $(BUILDDIR)/install/w90make \
		$(BUILDDIR)/wannier90/lib/*.a \
		$(BUILDDIR)/wannier90/bin/*.x \
		$(BUILDDIR)/wannier90/obj/*.o \
		$(BUILDDIR)/wannier90/obj/*.mod \
	cd $(TOPDIR)/external/wannier90; $(MAKE) clean && rm make.inc

w90_veryclean: w90_clean
	rm -f $(BUILDDIR)/install/w90git

w90_distclean: w90_veryclean
	rm -rf $(TOPDIR)/external/wannier90 $(BUILDDIR)/wannier90


###################################
# LAPACK (includes BLAS) - OBSOLETE?
###################################

liblapack:
	$(call update_submodule,external,lapack)
	if test ! -e $(BUILDDIR)/external/lapack/liblapack.a && test -e make_lapack.inc; then \
	  (cp make_lapack.inc $(TOPDIR)/external/lapack/make.inc; \
	   cd $(TOPDIR)/external/lapack; $(MAKE) blaslib lapacklib); \
	   cd $(BUILDDIR)/install && make -f extlibs_makefile lapack_install ; else \
      (echo "no configuration file found for lapack"; \
       echo "run configure from main QE dir"; exit) ; fi 

lapack_clean:
	if test -d $(TOPDIR)/external/lapack; then cd $(TOPDIR)/external/lapack; \
          (if test -f make.inc; then $(MAKE) clean; fi); fi

lapack_install:
	if test ! $(TOPDIR) -ef $(BUILDDIR) ; then \
	   mkdir -p $(BUILDDIR)/external/lapack/BLAS/SRC ; \
	   mkdir -p $(BUILDDIR)/external/lapack/INSTALL ; \
	   mkdir -p $(BUILDDIR)/external/lapack/SRC ; \
	   mv $(TOPDIR)/external/lapack/BLAS/SRC/*.o $(BUILDDIR)/external/lapack/BLAS/SRC/ ; \
	   mv $(TOPDIR)/external/lapack/INSTALL/*.o  $(BUILDDIR)/external/lapack/INSTALL/ ; \
	   mv $(TOPDIR)/external/lapack/SRC/*.o      $(BUILDDIR)/external/lapack/SRC/ ; \
	   mv $(TOPDIR)/external/lapack/*.a          $(BUILDDIR)/external/lapack/ ; \
	fi

###################################
# FoX - OBSOLETE?
###################################

libfox:
	$(call update_submodule,external,fox)
	if test ! -d $(BUILDDIR)/FoX ; then \
  cd $(TOPDIR)/external/fox; \
    ./configure --prefix=$(BUILDDIR)/FoX FC=$(F90) FCFLAGS="$(FOX_FLAGS)"; \
    touch cp_test; \
    if cp -p cp_test cp_test_1; then \
        rm cp_test_1; \
        echo "cp -p works"; \
    else \
        find -type f | xargs sed -i 's/cp -p/cp/g'; \
    fi; \
    rm cp_test; \
    $(MAKE) install && make clean; \
 cd -; \
fi
fox_clean:
	if test -d $(BUILDDIR)/FoX; then (rm -R -f $(BUILDDIR)/FoX); fi
	if test -d $(TOPDIR)/external/fox; then cd $(TOPDIR)/external/fox; \
          (if test -f FoX-config; then $(MAKE) clean; fi); fi


###################################
# cleaning
###################################

clean: lapack_clean fox_clean libdevx_clean libmbd_clean w90_clean

veryclean: clean libdevx_veryclean libmbd_distclean w90_veryclean

distlean: veryclean w90_distclean

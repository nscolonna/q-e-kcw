# Makefile for fundamental math and utility libraries: devXlib, MBD, W90

sinclude ../make.inc
include install_utils

all: libdevx libmbd libw90

###################################
# devxlib
###################################

libdevx : git_devx make_devx

git_devx :
	$(call update_submodule,external,devxlib)
	touch git_devx

make_devx : git_devx
	if test ! -f $(BUILDDIR)/devxlib/make_devx; then \
	mkdir -p $(BUILDDIR)/devxlib/src ; \
	cd $(TOPDIR)/external/devxlib/src; \
	ln -fs $(BUILDDIR)/make.inc ../; \
	( $(MAKE) all && touch $(BUILDDIR)/devxlib/make_devx ) ; \
	mv *.o *.mod *.a $(BUILDDIR)/devxlib/src/ ; fi

clean_devx:
	if test -d $(BUILDDIR)/devxlib/src; then \
		rm -f -R $(BUILDDIR)/devxlib/*; fi
	if test -f $(TOPDIR)/external/devxlib/make.inc; then \
	   cd $(TOPDIR)/external/devxlib; \
	   ( $(MAKE) clean && rm -f make.inc) ; fi

distclean_devx:
	if test ! -f git_devx; then rm git_devx ; fi

###################################
# LIBMBD
###################################

libmbd: git_mbd make_mbd

git_mbd:
	$(call update_submodule,external,mbd)
	touch git_mbd

make_mbd: git_mbd
	if test ! -f $(BUILDDIR)/MBD/make_mbd; then \
        mkdir $(BUILDDIR)/MBD; \
        cd $(TOPDIR)/external/mbd/src; \
        export FXX=$(F90); export FXXOPT="$(F90FLAGS)"; \
        ($(MAKE) -f ../../mbd.make && touch $(BUILDDIR)/MBD/make_mbd); \
	mv *.o *.mod *.a mbd_version.f90  $(BUILDDIR)/MBD; fi

clean_mbd:
	if test -d $(BUILDDIR)/MBD; then (rm -R -f $(BUILDDIR)/MBD); fi
	if test -d $(TOPDIR)/external/mbd/src; then \
		cd $(TOPDIR)/external/mbd/src; \
          $(MAKE) -f ../../mbd.make clean; fi

distclean_mbd:
	if test ! -f git_mbd; then rm git_mbd ; fi

###########################################################
# wannier90
###########################################################

libw90: git_w90 make_w90

git_w90:
	$(call update_submodule,external,wannier90)
	touch git_w90

# compile W90 sources, install library, executables, sources,
# respectively in lib/, bin/, obj/ under $(BUILDDIR)/wannier90
make_w90: git_w90
	if test ! -f $(BUILDDIR)/wannier90/make_w90; then \
	cp $(BUILDDIR)/install/make_wannier90.inc \
	   $(TOPDIR)/external/wannier90/make.inc ; \
	cd $(TOPDIR)/external/wannier90 ; \
	rm -rf src/obj src/objp *.a *.x libwannier.a ; \
	( $(MAKE) lib || exit 1) ; \
	( $(MAKE) PREFIX=$(BUILDDIR)/wannier90 install && \
	  touch $(BUILDDIR)/wannier90/make_w90 && \
          ( cd $(BUILDDIR)/bin && ln -fs ../wannier90/bin/*.x . ) ) ; \
	mkdir $(BUILDDIR)/wannier90/obj ; \
	mv src/obj/*.o src/obj/*mod $(BUILDDIR)/wannier90/obj ; \
	if test -d src/objp ; then \
	    mkdir -p $(BUILDDIR)/wannier90/objp ; \
	    mv src/objp/*.o src/objp/*mod $(BUILDDIR)/wannier90/objp ; \
	fi ; \
	rm -f *.a *.x ; fi
# wannier90 is built in place in the shared source tree, so the initial rm
# and final mv/rm lines clear and relocate obj/objp/lib/exe files to avoid
# different (possibly cross-compiler) out-of-source builds reusing stale,
# incompatible module files from a previous build against this checkout.

clean_w90:
	if test -d $(BUILDDIR)/wannier90 ; then \
	   rm -f -R $(BUILDDIR)/wannier90/* ; fi
	if test -d $(TOPDIR)/external/wannier90; then \
	   cd $(TOPDIR)/external/wannier90; \
	   ( $(MAKE) veryclean && rm make.inc ) ; fi

distclean_w90:
	if test ! -f git_w90; then rm git_w90 ; fi

###################################
# cleaning
###################################

clean: clean_devx clean_mbd clean_w90
veryclean: clean
distclean: distclean_devx distclean_mbd distclean_w90
